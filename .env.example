# ==============================================================================
# MASTER PROMPT STUDIO - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local or set these variables in your Vercel Project Settings.
# The application includes graceful zero-config degradation: if these keys are omitted,
# the app seamlessly functions in high-performance local mode with deterministic heuristics.

# 1. SUPABASE (Database, Cross-Device Auth & Signed Deliverable Storage)
# Get from: https://supabase.com/dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. GROQ CLOUD API (Free Ultra-Fast Live AI: Llama 3.3 70B & DeepSeek R1)
# Get free key from: https://console.groq.com/keys
VITE_GROQ_API_KEY=gsk_...

# 3. RESEND EMAIL API (Free Transactional Receipts & Booking Alerts: 3,000 emails/mo)
# Get free key from: https://resend.com/api-keys
VITE_RESEND_API_KEY=re_...
